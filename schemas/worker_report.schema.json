{
  "$defs": {
    "DepRequest": {
      "additionalProperties": false,
      "description": "A dependency a worker needs and the repo's dev image doesn't have.",
      "properties": {
        "ecosystem": {
          "enum": [
            "npm",
            "pypi"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "package": {
          "maxLength": 214,
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "ecosystem",
        "package",
        "version"
      ],
      "title": "DepRequest",
      "type": "object"
    },
    "ExecutorEvidence": {
      "additionalProperties": false,
      "description": "What vigild knows of the session that wrote the report, from its own\nrecords (#106). Every field is optional so older reports still load.",
      "properties": {
        "base_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Head"
        },
        "end_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Head"
        },
        "failure_diagnostic": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Diagnostic"
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Digest"
        },
        "launch_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch Head"
        },
        "lineage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lineage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ExecutorEvidence",
      "type": "object"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fork",
            "fresh",
            "resume"
          ],
          "title": "Mode",
          "type": "string"
        },
        "parent_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Session Id"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Lineage",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "claude",
        "local",
        "human",
        "eval-only"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SelfCheck": {
      "additionalProperties": false,
      "description": "The five questions every worker answers before returning.",
      "properties": {
        "could_delete": {
          "title": "Could Delete",
          "type": "string"
        },
        "not_done": {
          "title": "Not Done",
          "type": "string"
        },
        "outside_scope": {
          "items": {
            "type": "string"
          },
          "title": "Outside Scope",
          "type": "array"
        },
        "reviewer_would_flag": {
          "title": "Reviewer Would Flag",
          "type": "string"
        },
        "test_failed_first": {
          "title": "Test Failed First",
          "type": "boolean"
        }
      },
      "required": [
        "test_failed_first",
        "outside_scope",
        "not_done",
        "reviewer_would_flag",
        "could_delete"
      ],
      "title": "SelfCheck",
      "type": "object"
    },
    "TestOutcome": {
      "enum": [
        "fail",
        "pass",
        "unknown"
      ],
      "title": "TestOutcome",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutorEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "files_changed": {
      "items": {
        "type": "string"
      },
      "title": "Files Changed",
      "type": "array"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "needs_deps": {
      "items": {
        "$ref": "#/$defs/DepRequest"
      },
      "title": "Needs Deps",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "self_check": {
      "$ref": "#/$defs/SelfCheck"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "test_after": {
      "$ref": "#/$defs/TestOutcome",
      "default": "unknown"
    },
    "test_before": {
      "$ref": "#/$defs/TestOutcome",
      "default": "unknown"
    }
  },
  "required": [
    "task_id",
    "job_id",
    "files_changed",
    "summary",
    "self_check",
    "provenance"
  ],
  "title": "WorkerReport",
  "type": "object"
}
